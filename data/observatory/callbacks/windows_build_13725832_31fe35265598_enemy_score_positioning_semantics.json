  "findings": [
    {
      "claim": "Pod, grounded Hole, targeted danger, Smoke, new Fire, spawning, generic danger, avoided dangerous item, and grounded Water short-circuit in that order.",
      "classification": "fact",
      "id": "hazard_short_circuit_order_is_exact"
    },
    {
      "claim": "The only Board:IsAcid positioning line is commented out, so the shipped function deliberately applies no ACID penalty.",
      "classification": "fact",
      "id": "acid_penalty_is_inactive"
    },
    {
      "claim": "A nonzero Pawn custom score returns before the hard-coded x/y zero-or-seven corner and edge policy.",
      "classification": "fact",
      "id": "custom_score_precedes_stock_edges"
    },
    {
      "claim": "TEAM_PLAYER selects TEAM_ENEMY; every other Pawn team selects TEAM_PLAYER, matching the source's explicit black/white caveat.",
      "classification": "fact",
      "id": "enemy_team_selection_is_binary"
    },
    {
      "claim": "For each of four DIR_START-through-DIR_END slots, melee scoring checks selected-team Pawn first and Building second, returning five at the first match.",
      "classification": "fact",
      "id": "melee_adjacency_order_is_exact"
    },
    {
      "claim": "Without adjacency, melee scoring returns max(0,(10-min(Pawn distance,Building distance))/2) as a Lua number, so odd differences remain half-points in direct Lua callers.",
      "classification": "fact",
      "id": "melee_distance_preserves_half_points"
    },
    {
      "claim": "A ranged Pawn that reaches the interior tail returns five.",
      "classification": "fact",
      "id": "ranged_interior_returns_five"
    },
    {
      "claim": "The exact native Pawn helpers dispatch generated GetScoreDanger and GetPositionScore methods. Unmodified shipped Pawn definitions inherit ScoreDanger=-10 and PositionScore=0 with no explicit getter or field override in the shipped Lua corpus.",
      "classification": "fact",
      "id": "stock_pawn_score_helpers_resolve_to_inherited_defaults"
    },
    {
      "claim": "The native named integer route reaches lua_tointeger, whose exact pinned DLL body converts the double with x87 FISTP; the four-mode replay therefore requires the active thread rounding mode.",
      "classification": "fact",
      "id": "native_integer_rounding_depends_on_x87_control"
    },
    {
      "claim": "Every named Board/Pawn observation used by ScorePositioning is pinned to its exact-build native binding and implementation. The current bridge carries or exactly derives most current-state values, while native dangerous flags/effects and a future candidate-time Board snapshot remain explicit inputs.",
      "classification": "fact",
      "id": "native_observation_boundaries_and_current_carriers_are_exact"
    }
  ],
