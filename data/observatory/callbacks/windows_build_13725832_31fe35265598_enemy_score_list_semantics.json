  "contracts": {
    "base_vector_choice": "empty q_effect uses instant; nonempty q_effect uses queued",
    "branch_order": [
      "movement_position",
      "non_grid_structure",
      "friendly_damage",
      "enemy",
      "powered_building_damage",
      "instant_pod_veto",
      "nothing"
    ],
    "enemy_helper": "both teams differ and neither equals the projected TEAM_NONE",
    "future_board_state_is_not_fabricated": true,
    "instant_catastrophe_gate": "instant_score < -20 => -100",
    "movement_position_override": "sum < -5",
    "numeric_scope": "damage, teams, and score weights are signed 32-bit; positioning values and accumulators are exact finite Lua numbers within 2^53",
    "outer_gate": "Board:IsValid(loc) or movement starts at Pawn:GetSpace()",
    "record_order": "input vector order",
    "score_positioning_is_projected_input": true
  },
