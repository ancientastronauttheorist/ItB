  "findings": [
    {
      "claim": "Skill:GetTargetScore directly calls self:GetSkillEffect once, scores effect and q_effect, rejects instant scores below -20, and otherwise prefers queued score whenever q_effect is nonempty.",
      "classification": "fact",
      "id": "base_score_directly_materializes_actual_effect"
    },
    {
      "claim": "The native score wrapper invokes Lua GetTargetScore, whose source directly dispatches GetSkillEffect. That route does not call the separate native Skill cache materializer at RVA 0x00268050.",
      "classification": "inference",
      "id": "score_side_effect_bypasses_native_cache_materializer"
    },
    {
      "claim": "Exactly Skill, CentipedeAtk1, CentipedeAtkB, and MosquitoAtkB GetTargetScore definitions directly call self:GetSkillEffect.",
      "classification": "fact",
      "id": "four_direct_actual_effect_definitions"
    },
    {
      "claim": "ShamanAtk1 calls TotemAtk1:GetTargetScore in four directions after its gates. TotemAtk1 inherits Skill:GetTargetScore and therefore materializes TotemAtk1:GetSkillEffect on each nested evaluation.",
      "classification": "fact",
      "id": "shaman_nested_totem_effect_route"
    },
    {
      "claim": "DungAtk1, ScarabAtkB, StarfishAtkB1, and BlobberAtk1 score a locally constructed synthetic SkillEffect rather than their actual GetSkillEffect payload.",
      "classification": "fact",
      "id": "four_synthetic_score_effects"
    },
    {
      "claim": "The remaining eleven active definitions use constants or direct Board/deploy logic without scoring an actual or synthetic effect payload.",
      "classification": "fact",
      "id": "eleven_effect_payload_free_scores"
    },
    {
      "claim": "None of the 20 active GetTargetScore bodies calls GetFinalEffect or GetFinalEffect_Helper; the base score route always uses GetSkillEffect.",
      "classification": "fact",
      "id": "score_callbacks_never_call_final_effect"
    },
    {
      "claim": "Across all 186 active GetSkillEffect definitions, there are zero direct calls to random_int, random_bool, random_element, or random_removal.",
      "classification": "fact",
      "id": "skill_effect_bodies_have_no_explicit_lua_rng_calls"
    }
  ],
