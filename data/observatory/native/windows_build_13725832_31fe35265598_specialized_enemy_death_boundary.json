  "findings": [
    {
      "claim": "Mission_Boss:StartBoss calls the one-argument named Pawn factory. That wrapper selects GetDefaultTeam, allocates one common 0x1328-byte Pawn object, installs the common Pawn vtable, and loads the Lua definition.",
      "classification": "fact",
      "id": "bosses_use_common_pawn_factory"
    },
    {
      "claim": "Board master update reaches the shared Pawn update. Its guarded death call is the sole direct caller of the common death processor.",
      "classification": "fact",
      "id": "common_death_dispatch"
    },
    {
      "claim": "The reached ordinary branch requires IsMech=false and team 6, then emits event 2 for Minor=false or event 12 for Minor=true. No leader, tier, boss, Psion, or Pawn type-name gate appears in the reviewed body.",
      "classification": "fact",
      "id": "ordinary_enemy_event_predicate"
    },
    {
      "claim": "The accepted 153-file Lua tree has exactly 17 active Minor=true Pawn definitions, no child derived from one of those Minor types, and two non-effective commented BlobBoss Minor lines.",
      "classification": "fact",
      "id": "exact_shipped_minor_inventory"
    },
    {
      "claim": "All 21 nonempty BossPawn objectives are literal TEAM_ENEMY definitions that retain the global Minor=false default, so their ordinary deaths emit event 2. BlobB, TotemB, SlugEgg1, and SpiderlingEgg1 are the four boss-specific Minor auxiliaries and emit event 12 instead.",
      "classification": "inference",
      "id": "boss_and_auxiliary_classification"
    },
    {
      "claim": "BlobBossMed and BlobBossSmall inherit the non-Minor BlobBoss definition; the commented Minor assignments do not execute. Each split form therefore contributes its own ordinary event-2 death.",
      "classification": "inference",
      "id": "blob_split_forms_each_count"
    },
    {
      "claim": "Rust now excludes IS_MECH before mission-kill projection and retains the Minor and Mission_AcidTank ACID filters. Simulator v407 archives the pre-change v406 failure corpus.",
      "classification": "fact",
      "id": "rust_enemy_mech_discrepancy_fixed"
    }
  ],
