  "findings": [
    {
      "claim": "On the exact Windows build, phase_transition returns from CreateNextPhase, selects and loads a map, performs intermediate board initialization, and then dispatches BaseStart.",
      "evidence_class": "inference",
      "id": "native_startup_order",
      "supports": [
        "post_create_native_order",
        "phase_to_create_next_invoker",
        "phase_to_map_selector",
        "phase_to_map_loader",
        "phase_to_base_start_dispatch",
        "base_start_to_named_invoker"
      ]
    },
    {
      "claim": "The exact map revision contains nine final_cave-tagged maps; all share the same four deployment tiles and each supplies seven pylon tiles plus three or four mountain-drop tiles.",
      "evidence_class": "fact",
      "id": "final_cave_map_pool",
      "supports": [
        "maps/cave1.map",
        "maps/cave2.map",
        "maps/cave3.map",
        "maps/cave4.map",
        "maps/cave5.map",
        "maps/caveAE1.map",
        "maps/caveAE2.map",
        "maps/caveAE3.map",
        "maps/caveAE4.map"
      ]
    },
    {
      "claim": "Exact Lua runs Env_Final:Start before Mission_Final_Cave:StartMission, then SetupDiffMod, then ordinary starting SpawnPawns.",
      "evidence_class": "fact",
      "id": "base_start_source_order",
      "supports": [
        "scripts/missions/missions.lua",
        "scripts/missions/final/env_final.lua",
        "scripts/missions/final/mission_final_two.lua"
      ]
    },
    {
      "claim": "Exact Lua pins the relative random_int/random_bool call skeleton from the one-entry map tag through environment path, bomb/mech assignment, dropper order, boss choice, and later difficulty/start-spawn work.",
      "evidence_class": "fact",
      "id": "startup_rng_skeleton",
      "supports": [
        "rng_schedule"
      ]
    },
    {
      "claim": "The bomb consumes one of four center deployment tiles and mech IDs 0, 1, and 2 consume the other three, producing 24 source-reachable assignment permutations.",
      "evidence_class": "fact",
      "id": "center_assignment",
      "supports": [
        "startup_contract",
        "scripts/missions/final/mission_final_two.lua"
      ]
    },
    {
      "claim": "No cross-stage Rust forecast is justified yet: native map and spawn choices plus effect settlement remain unresolved. The solver should keep detecting the stage change and consuming a fresh settled bridge state.",
      "evidence_class": "inference",
      "id": "solver_boundary",
      "supports": [
        "native_startup_order",
        "final_cave_map_pool",
        "startup_rng_skeleton"
      ]
    }
  ],
