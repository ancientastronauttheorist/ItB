  "findings": [
    {
      "claim": "BoardPlayer initializes primary +0x1900 and secondary +0x1904 to pending code 2. The state jump table maps state 2 to a nonforced outcome-dispatch call and state 0 to a forced call.",
      "evidence_class": "inference",
      "id": "outcome_storage_and_callers_are_exact",
      "limitations": [
        "Debug/cheat writers of the secondary result are outside ordinary reachability."
      ],
      "supports": [
        "pending_codes_initialized",
        "state_case_zero",
        "state_case_two",
        "turn_state_store_and_dispatch",
        "state_two_nonforced_outcome_dispatch",
        "state_zero_forced_outcome_dispatch"
      ]
    },
    {
      "claim": "On the ordinary Final Cave state-2 boundary, current turn equal to the current GetTurnLimit makes end readiness true and the outcome dispatcher writes code 1. It then selects the Final victory route, dispatches MissionEnd, and requests completion state 5.",
      "evidence_class": "inference",
      "id": "final_cave_limit_writes_victory",
      "limitations": [
        "The precise runtime frame on which each presentation step appears is not claimed."
      ],
      "supports": [
        "state_two_nonforced_outcome_dispatch",
        "outcome_to_end_readiness",
        "final_limit_short_circuit",
        "ordinary_ready_writes_success",
        "final_victory_route",
        "mission_end_then_state_five"
      ]
    },
    {
      "claim": "The closed ordinary path from the state-2 caller through the ready return and code-1 write contains no bomb, objective, or IsEndBlocked query. Final Cave's always-true IsEndBlocked and zero-reputation objective callback do not veto that reached countdown boundary.",
      "evidence_class": "inference",
      "id": "countdown_does_not_recheck_bomb_or_objectives",
      "limitations": [
        "Earlier UpdateMission work can change when the boundary is reached."
      ],
      "supports": [
        "scripts/missions/final/mission_final_two.lua",
        "final_limit_short_circuit",
        "ordinary_ready_writes_success",
        "ordinary_final_cave_countdown"
      ]
    },
    {
      "claim": "A missing BigBomb is handled in shipped Lua by queuing a replacement and adding two to TurnLimit. Native readiness queries that current value, and the reached limit writes victory without a second bomb check. Bomb destruction is therefore a delay/replacement boundary, not a direct terminal loss predicate in the reviewed path.",
      "evidence_class": "inference",
      "id": "missing_bomb_delays_instead_of_directly_losing",
      "limitations": [
        "Replacement uncertainty can still make a projected plan unsafe to execute blindly."
      ],
      "supports": [
        "scripts/missions/final/mission_final_two.lua",
        "get_turn_limit",
        "missing_bomb_lifecycle",
        "final_cave_limit_writes_victory"
      ]
    },
    {
      "claim": "Only while the primary result remains pending does a forced state-0 evaluation call the exact Board:GetPawnCount binding with TEAM_MECH value 4. A zero result writes failure code 3; the ordinary state-2 limit victory has already committed code 1 and does not enter this branch.",
      "evidence_class": "inference",
      "id": "forced_zero_mech_failure_is_separate",
      "limitations": [
        "The map uses only the exact zero/nonzero contract needed by the outcome writer."
      ],
      "supports": [
        "get_pawn_count_binding",
        "team_mech_constant",
        "pawn_count_zero_contract",
        "forced_zero_mechs_writes_failure",
        "state_zero_forced_outcome_dispatch"
      ]
    },
    {
      "claim": "The pinned BoardPlayer vtable getter returns +0x1900. The downstream campaign artifact maps code 3 to result 2 and other committed results, including code 1, to result 1; result 1 is the campaign-victory settlement route.",
      "evidence_class": "inference",
      "id": "campaign_result_join_is_exact",
      "limitations": [
        "Runtime filesystem success and a concrete run's written bytes remain separate evidence."
      ],
      "supports": [
        "outcome_getter_vtable_slot",
        "outcome_getter_body",
        "campaign_consumption",
        "data/observatory/native/windows_build_13725832_31fe35265598_final_campaign_settlement.json"
      ]
    },
    {
      "claim": "No Rust simulator semantic change follows. Simulator v406 already applies the source-guaranteed +2 missing-bomb edge and stops at unresolved replacement materialization. The combat solver should continue to treat current-bomb loss as strategically severe and require a fresh live board before forecasting from the replacement.",
      "evidence_class": "inference",
      "id": "solver_boundary",
      "limitations": [
        "This proof does not resolve native replacement timing or coordinates."
      ],
      "supports": [
        "missing_bomb_delays_instead_of_directly_losing",
        "final_cave_limit_writes_victory"
      ]
    }
  ],
