  "findings": [
    {
      "claim": "The prior anonymous candidate-clamp fields are the Pawn bInjured byte and current health integer. Normal planning passes zero, so a moved injured one-HP pawn cannot retain a positive positioning score.",
      "evidence_class": "inference",
      "id": "positioning_clamp_fields_resolved",
      "limitations": [
        "The Lua ScorePositioning callback remains an input to this replay."
      ]
    },
    {
      "claim": "Only the reviewed debugai route passes mode one; the ordinary enemy orchestrator passes mode zero.",
      "evidence_class": "fact",
      "id": "debug_route_is_distinct",
      "limitations": [
        "The artifact does not treat debugai observations as ordinary runtime behavior."
      ]
    },
    {
      "claim": "The GetTargetScore wrapper subtracts five at targetHistory and adds ten at priorityTarget, with priorityTarget winning when both match.",
      "evidence_class": "inference",
      "id": "target_history_and_priority_modifiers",
      "limitations": [
        "The game-specific code that sets those two points is not replayed here."
      ]
    },
    {
      "claim": "A negative native modifier never turns a positive callback score into zero or a negative score; results within the penalty magnitude become one.",
      "evidence_class": "fact",
      "id": "positive_callback_floor",
      "limitations": [
        "Other sums follow native signed 32-bit arithmetic."
      ]
    },
    {
      "claim": "The candidate loop rewrites an out-of-range selected weapon to zero before target-area and target-score work, while the wrapper itself has a separate literal-index-50 resolver exception.",
      "evidence_class": "inference",
      "id": "candidate_weapon_normalization_precedes_wrapper",
      "limitations": [
        "The shipped semantic name of literal index 50 remains unresolved."
      ]
    },
    {
      "claim": "These helpers close native arithmetic around callback results but do not provide future callback outputs or target areas to the solver.",
      "evidence_class": "fact",
      "id": "solver_scope_unchanged",
      "limitations": [
        "No Rust simulator change or version bump follows from this boundary alone."
      ]
    }
  ],
