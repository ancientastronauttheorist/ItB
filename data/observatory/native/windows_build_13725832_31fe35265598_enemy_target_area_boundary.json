  "findings": [
    {
      "claim": "The exact normal-route predicate is fully parameterized by IsActive, the named smoke and Water helpers, iBonusShift, the usable-skill scan, and IsMech. Debugai mode one bypasses an ordinary failure.",
      "classification": "inference",
      "id": "ordinary_target_area_gate_closed"
    },
    {
      "claim": "Smoke disables attacks only on an attached Board smoke tile while not busy and without IgnoreSmoke or Disable_Immunity. Terrain three is the registered TERRAIN_WATER value; it blocks only a not-busy, nonflying Pawn.",
      "classification": "inference",
      "id": "smoke_and_water_helpers_named"
    },
    {
      "claim": "The vector scan excludes exact IDs Move and Move_Power and otherwise accepts an unlimited Skill or a limited Skill with positive remaining uses.",
      "classification": "inference",
      "id": "usable_skill_rule_closed"
    },
    {
      "claim": "Literal index 50 resolves before vector bounds to the separately owned Skill_Repair shared pointer. It is not vector slot 51.",
      "classification": "inference",
      "id": "literal_50_is_repair"
    },
    {
      "claim": "The candidate loop rewrites selected index 50 to zero whenever the vector count is at most 50, before target-area dispatch. The exact shipped one-line SkillList definitions have maximum literal arity two, but that source fact is not promoted to a universal runtime vector-count theorem.",
      "classification": "inference",
      "id": "small_vector_normalization"
    },
    {
      "claim": "The Rust solver consumes settled queued actions and lacks the prospective callback payload. No simulator contradiction or version change follows.",
      "classification": "fact",
      "id": "no_solver_semantic_change"
    }
  ],
