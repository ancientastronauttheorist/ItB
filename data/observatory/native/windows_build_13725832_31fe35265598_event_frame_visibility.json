  "findings": [
    {
      "claim": "The sole direct event-publisher call occurs before the same outer update's Game vtable +0x04 dispatch. The same outer object constructs that exact Game type and retains it at the dispatched +0x18 field.",
      "classification": "fact",
      "id": "publisher_precedes_game_update"
    },
    {
      "claim": "Game vtable +0x04 is the pinned Game update; active mode 1 enters battle update, which invokes the present +0xc204 controller at vtable +0x10. BoardPlayer construction installs the pinned vtable, whose +0x10 slot is the primary orchestrator.",
      "classification": "fact",
      "id": "game_to_boardplayer_join"
    },
    {
      "claim": "The primary orchestrator calls Board master update, which reaches the effect queue, before preparing and invoking Mission:BaseUpdate.",
      "classification": "fact",
      "id": "board_effect_before_base_update"
    },
    {
      "claim": "A death event recorded during Board/effect processing enters pending after that outer update's only publication point, so the later same-update BaseUpdate reader cannot see it.",
      "classification": "inference",
      "id": "same_update_invisibility"
    },
    {
      "claim": "The next ordinary outer update promotes the pending batch before Game and BoardPlayer dispatch, allowing its later BaseUpdate to read it.",
      "classification": "inference",
      "id": "next_update_visibility"
    },
    {
      "claim": "The Rust simulator accounts for mission kills as resolved action outcomes rather than emulating Lua callback visibility per outer update; this scheduling evidence contradicts no current transition rule.",
      "classification": "inference",
      "id": "rust_model_remains_conformant"
    }
  ],
