  "findings": [
    {
      "claim": "The effect update calls the dispatcher with this adjusted to Board+0x0c. The dispatcher's +0x2d14 vector therefore aliases primary Board+0x2d20, so its PylonAnimation factory result is immediately visible to the Board activity and update loops.",
      "evidence_class": "inference",
      "id": "dispatcher_result_enters_busy_vector",
      "limitations": [
        "The field names are analyst labels; the offsets and pointer adjustment are exact."
      ],
      "supports": [
        "dispatcher_secondary_this",
        "board_effect_dispatch_slot",
        "dispatcher_active_append",
        "activity_active_loop",
        "master_active_loop"
      ]
    },
    {
      "claim": "The exact game.lua pod_z value 300 makes the constructor's start-height field positive before its IEEE-754 sign bit is flipped, so object+0x1d4 starts strictly negative; pod_velocity 0.7 controls the derived trajectory. Both Pylon lifetime and activity predicates stay true while the fall field is negative. The Pylon update clamps it nonnegative only on landing and then synchronously calls impact, leaving no callback-visible nonbusy/no-bomb gap.",
      "evidence_class": "inference",
      "id": "pylon_is_busy_until_impact",
      "limitations": [
        "Wall-clock animation duration and rendering cadence are not derived."
      ],
      "supports": [
        "scripts/game.lua",
        "pod_z_name",
        "pod_velocity_name",
        "float_sign_mask",
        "constructor_start_height_sign",
        "pylon_lifetime_slot",
        "pylon_busy_slot",
        "pylon_update_slot",
        "pylon_impact_slot",
        "pylon_fall_to_impact"
      ]
    },
    {
      "claim": "A newly queued replacement first blocks IsBusy through the effect vector, then through the active PylonAnimation until impact materializes BigBomb. Subsequent UpdateMission calls therefore cannot queue a duplicate; another +2/replacement cycle requires that materialized bomb to be lost later and the Board to become idle again.",
      "evidence_class": "inference",
      "id": "replacement_repeat_cadence_is_exact",
      "limitations": [
        "The selected coordinate, new UID, and elapsed presentation time remain unknown."
      ],
      "supports": [
        "final_cave_replacement",
        "dispatcher_result_enters_busy_vector",
        "pylon_is_busy_until_impact",
        "master_active_loop",
        "master_effect_update_call"
      ]
    },
    {
      "claim": "No Rust simulator semantic change is justified. Simulator v406 already applies one +2 edge, stops projection before fabricating the replacement pawn, and requires a fresh settled bridge read; cadence proof removes a native ambiguity without making coordinate or UID prediction possible.",
      "evidence_class": "inference",
      "id": "solver_boundary",
      "limitations": [
        "A future proven RNG-state boundary could justify a narrower handoff."
      ],
      "supports": [
        "replacement_repeat_cadence_is_exact",
        "final_cave_replacement"
      ]
    }
  ],
