  "findings": [
    {
      "claim": "On the reviewed ordinary state-2 limit boundary, native end readiness returns true before constructing or invoking IsEndBlocked. The always-true Final callbacks therefore do not veto this exact branch.",
      "evidence_class": "inference",
      "id": "final_limit_bypasses_end_block",
      "limitations": [
        "Other state/turn combinations continue through the separate fallback gates."
      ],
      "supports": [
        "end_readiness",
        "get_turn_limit",
        "final_limit_short_circuit",
        "is_end_blocked"
      ]
    },
    {
      "claim": "Mission_Final and Mission_Final_Cave both inherit the native turn-limit completion mechanism despite overriding IsEndBlocked to true. The cave's source-level +2 replacement extension moves the equality boundary because native code queries the current GetTurnLimit value.",
      "evidence_class": "inference",
      "id": "both_final_stages_use_current_limit",
      "limitations": [
        "This does not make bomb destruction a terminal loss or predict replacement coordinates."
      ],
      "supports": [
        "scripts/missions/missions.lua",
        "scripts/missions/final/mission_final.lua",
        "scripts/missions/final/mission_final_two.lua",
        "ordinary_final_end_trigger"
      ]
    },
    {
      "claim": "Both shipped Final MissionEnd callbacks call Board:AddEffect. The exact AddEffect registration selects the reviewed native binding, which copies the SkillEffect and appends it to the Board vector rooted at +0x2c50.",
      "evidence_class": "inference",
      "id": "mission_end_queues_native_effect",
      "limitations": [
        "Individual presentation opcodes inside the effect are not reconstructed here."
      ],
      "supports": [
        "scripts/missions/final/mission_final.lua",
        "scripts/missions/final/mission_final_two.lua",
        "board_add_effect",
        "add_effect_registration",
        "board_add_effect_to_effect_enqueue",
        "effect_enqueue_vector"
      ]
    },
    {
      "claim": "A nonempty +0x2c50 effect vector returns Board activity reason 6; the exact Board secondary-vtable slot converts any nonzero reason to true, and BoardPlayer's activity slot delegates to that Board slot.",
      "evidence_class": "inference",
      "id": "queued_effect_is_board_activity",
      "limitations": [
        "Reason 6 is one of several activity sources checked by the comprehensive routine."
      ],
      "supports": [
        "effect_queue_activity_reason",
        "activity_reason_to_boolean",
        "board_activity_slot",
        "boardplayer_activity_slot",
        "boardplayer_activity_bridge"
      ]
    },
    {
      "claim": "After dispatching MissionEnd, native code requests BoardPlayer completion state 5. The primary orchestrator exits the handoff branch while BoardPlayer activity is true; only after it is false can state 5 reach IsNextPhase and the surface phase transition.",
      "evidence_class": "inference",
      "id": "phase_handoff_waits_for_activity_clear",
      "limitations": [
        "Additional native flags in the same handoff branch can delay it further."
      ],
      "supports": [
        "mission_end_callback_then_state_five",
        "turn_state_store",
        "handoff_activity_gate",
        "primary_to_is_next_phase",
        "primary_to_phase_transition"
      ]
    },
    {
      "claim": "Mission_Final's queued fall/slide effect and Mission_Final_Cave's queued StartMechTravel effect keep the reviewed handoff/exit gate closed at least until their native effect vector is empty and the comprehensive Board activity check returns zero.",
      "evidence_class": "inference",
      "id": "final_mission_end_effects_precede_exit",
      "limitations": [
        "The later campaign-victory UI and save settlement are not mapped."
      ],
      "supports": [
        "mission_end_queues_native_effect",
        "queued_effect_is_board_activity",
        "phase_handoff_waits_for_activity_clear"
      ]
    },
    {
      "claim": "No Rust simulator semantic change follows. Combat still ends at the live limit boundary, and cross-stage state must still come from a fresh settled bridge read rather than fabricated MissionEnd animation or cave-start results.",
      "evidence_class": "inference",
      "id": "solver_boundary",
      "limitations": [
        "Concrete cave RNG and post-travel campaign state remain separate boundaries."
      ],
      "supports": [
        "both_final_stages_use_current_limit",
        "phase_handoff_waits_for_activity_clear"
      ]
    }
  ],
