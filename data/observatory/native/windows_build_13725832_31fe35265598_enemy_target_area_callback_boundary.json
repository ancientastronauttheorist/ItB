  "findings": [
    {
      "claim": "Skill +0x110 is the Board +0x0c secondary/path-manager interface: Board:AddPawn passes that exact adjusted pointer, the manager writes it to all vector Skills and Skill_Repair, and slot +0x14 is the exact -0x0c this-adjust thunk to Board:IsValid.",
      "evidence_class": "inference",
      "id": "skill_context_is_board_secondary_interface",
      "limitations": [
        "Semantic names derive from joined exact control flow and the prior Board-constructor artifact; no debug symbols exist."
      ]
    },
    {
      "claim": "An invalid origin invokes no Lua target-area callback, move-assigns a fresh empty PointList over the prior Skill cache, and returns empty.",
      "evidence_class": "inference",
      "id": "invalid_origin_clears_cache",
      "limitations": [
        "The replay requires an attached, readable Board context."
      ]
    },
    {
      "claim": "A valid origin dispatches GetSecondTargetArea only when TwoClick is true and neither second-target coordinate equals -1; all other cases dispatch GetTargetArea.",
      "evidence_class": "inference",
      "id": "two_click_callback_selection",
      "limitations": [
        "Values less than -1 are not rejected by this dispatch predicate."
      ]
    },
    {
      "claim": "The native wrapper replaces the cache with the callback PointList, erases only points with negative x or y, and preserves order, duplicates, and nonnegative out-of-board coordinates.",
      "evidence_class": "inference",
      "id": "native_post_callback_filter",
      "limitations": [
        "Lua-to-native conversion and the concrete returned points remain boundary inputs."
      ]
    },
    {
      "claim": "The exact executable has six raw direct callers to the callback wrapper and six raw direct callers to the SkillManager context writer.",
      "evidence_class": "fact",
      "id": "complete_direct_caller_census",
      "limitations": [
        "Raw direct-call completeness does not enumerate indirect calls or assign semantic names beyond the reviewed enclosing functions."
      ]
    },
    {
      "claim": "The ordinary bridge still lacks future ordered Lua callback PointLists, so the settled live enemy queue remains authoritative.",
      "evidence_class": "fact",
      "id": "solver_scope_unchanged",
      "limitations": [
        "No Rust simulator semantic or version change follows from this artifact alone."
      ]
    }
  ],
