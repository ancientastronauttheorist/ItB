  "findings": [
    {
      "claim": "Seventeen Board/Pawn names used by ScorePositioning bind to the reviewed exact-build members; IsPawnTeam reaches its implementation through secondary-vtable slot +0x88.",
      "classification": "fact",
      "id": "all_named_observation_bindings_are_exact"
    },
    {
      "claim": "Board:IsDangerous tests tile byte +0x2af0 and exact Point membership in Board vectors +0x7460 and +0x7470; it does not call Board:IsEnvironmentDanger.",
      "classification": "fact",
      "id": "dangerous_is_not_environment_danger"
    },
    {
      "claim": "An item is dangerous only when present and at least one of iDamage, non-DIR_NONE iPush, iShield, iFire, iSmoke, nonempty sPawn, iAcid, or iFrozen is active.",
      "classification": "fact",
      "id": "dangerous_item_has_eight_effect_tests"
    },
    {
      "claim": "Board:IsSpawning returns true from either tile byte +0x27e8 or membership in Board Point vector +0x2d50/+0x2d54.",
      "classification": "fact",
      "id": "spawning_has_two_native_sources"
    },
    {
      "claim": "Board:IsTargeted walks active Board objects and returns true at the first object whose native Point predicate matches; the bridge's direct all-board scan preserves that result.",
      "classification": "fact",
      "id": "targeted_is_direct_object_membership"
    },
    {
      "claim": "For ScorePositioning's only queries, TEAM_PLAYER=1 requires exact team one and TEAM_ENEMY=6 accepts every actual team greater than or equal to six.",
      "classification": "fact",
      "id": "score_team_queries_are_simple"
    },
    {
      "claim": "GetDistanceToPawn uses literal low profile six; exact traversal and wall bodies admit every valid cardinal neighbor at unit cost, so its minimum distance to a matching on-board Pawn is Manhattan and empty is INT_MAX.",
      "classification": "inference",
      "id": "pawn_distance_is_manhattan"
    },
    {
      "claim": "The native cache builder clears +0x2c44/+0x2c48 and appends every terrain-one Point; GetDistanceToBuilding returns minimum Manhattan distance over that explicit cache or INT_MAX when empty.",
      "classification": "fact",
      "id": "building_distance_uses_terrain_one_cache"
    },
    {
      "claim": "IsRanged is exact Lua integer equality with one; IsAvoidingMines is an exact Lua boolean; IsFlying combines its Lua property and runtime byte then rejects dead Pawns. The ordinary bridge directly exports only IsFlying.",
      "classification": "fact",
      "id": "pawn_definition_flags_are_exact_but_not_all_live_carriers"
    },
    {
      "claim": "These findings refine prospective native enemy scoring inputs; the Rust solver still consumes the settled queue and no current simulator rule contradicts the boundary.",
      "classification": "inference",
      "id": "no_solver_contradiction"
    }
  ],
