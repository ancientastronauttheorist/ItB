  "findings": [
    {
      "claim": "Mission_Final_Cave:MissionEnd's StartMechTravel script resolves to the pinned native handler. It enables Board travel mode, resets its state, sets 4.5 seconds, populates +0x2cc0, and in ordinary mode locates BigBomb and stores its coordinates.",
      "evidence_class": "inference",
      "id": "start_mech_travel_initializes_native_queue",
      "limitations": [
        "The travel-vector element schema is not reconstructed."
      ],
      "supports": [
        "scripts/missions/final/mission_final_two.lua",
        "start_mech_travel_binding",
        "start_mech_travel_initialization",
        "big_bomb_lookup"
      ]
    },
    {
      "claim": "The Board update drains +0x2c50 effects before +0x2cc0 travel. Once ordinary travel is empty, the reviewed path constructs Board:LockBomb() followed by Board:Fade(FADE_EXPLODE).",
      "evidence_class": "inference",
      "id": "travel_queue_finishes_with_bomb_lock_and_fade",
      "limitations": [
        "Individual animation timestamps remain runtime behavior."
      ],
      "supports": [
        "effect_queue_precedes_travel",
        "travel_queue_gate",
        "travel_completion_gate",
        "lock_bomb_script",
        "fade_explode_script"
      ]
    },
    {
