  "findings": [
    {
      "claim": "The registered shipped IsRelease wrapper returns true, so FAST_VERSION is false and every source-level release voice and delay branch is included.",
      "evidence_class": "inference",
      "id": "release_branch_is_exact",
      "supports": [
        "is_release_name",
        "is_release_registration",
        "is_release_wrapper",
        "scripts/missions/final/mission_final_two.lua"
      ]
    },
    {
      "claim": "The reviewed AddVoice, AddDelay, AddDropper, AddScript, and AddBoardShake wrappers immediately reach the common 0x134-byte append. Complete record copies preserve source call order and insulate earlier records from later Lua object mutation.",
      "evidence_class": "inference",
      "id": "builders_append_independent_records",
      "supports": [
        "vector_push_tail",
        "vector_push_to_copy",
        "voice_to_push",
        "delay_to_push",
        "dropper_to_push",
        "script_to_push",
        "shake_to_push"
      ]
    },
    {
      "claim": "The dispatcher starts at record zero and advances by one 0x134-byte record. A nonzero delay stores the suffix beginning at the next record plus its duration, so later continuation preserves the remaining record order.",
      "evidence_class": "inference",
      "id": "delays_partition_without_reordering",
      "supports": [
        "dispatcher_order_setup",
        "dispatcher_delay_gate_advance",
        "dispatcher_delay_suffix",
        "dispatcher_to_suffix_insert",
        "dispatcher_to_delay_insert",
        "final_cave_replacement_cadence"
      ]
    },
    {
      "claim": "On an unmodified valid startup, the three queued chunks are dispatched in Mech-id order 0, 1, 2. Kind zero reaches Board SpaceDamage apply, which evaluates each nonempty script through luaL_loadbuffer and synchronous lua_pcall before proceeding.",
      "evidence_class": "inference",
      "id": "mech_scripts_are_attempted_in_id_order",
      "limitations": [
        "Arbitrary modified-state Lua errors or cancellation are not ruled out."
      ],
      "supports": [
        "scripts/missions/final/mission_final_two.lua",
        "script_build_append",
        "dispatcher_kind_zero_apply",
        "board_apply_vtable_slot",
        "apply_script_first",
        "evaluator_to_lual_loadbuffer",
        "evaluator_to_lua_pcall"
      ]
    },
    {
      "claim": "Each of the seven exact pylon iterations appends two consecutive independent building-dropper records before its following 0.5 delay. This proves two record and animation creations, not their eventual visual overlap or impact order.",
      "evidence_class": "inference",
      "id": "duplicate_pylon_droppers_are_real_records",
      "supports": [
        "scripts/missions/final/mission_final_two.lua",
        "builders_append_independent_records",
        "delays_partition_without_reordering",
        "final_cave_startup"
      ]
    },
    {
      "claim": "For exact cave maps, ordered dispatch is delay/shake, all mountain pairs, Mech scripts 0-2, all duplicated pylon pairs, and the final bomb dropper. The exact record total is 44 for three mountains and 46 for four.",
      "evidence_class": "inference",
      "id": "startup_effect_order_is_closed",
      "supports": [
        "release_branch_is_exact",
        "builders_append_independent_records",
        "delays_partition_without_reordering",
        "mech_scripts_are_attempted_in_id_order",
        "duplicate_pylon_droppers_are_real_records"
      ]
    },
