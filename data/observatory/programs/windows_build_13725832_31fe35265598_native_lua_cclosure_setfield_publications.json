  "method": {
    "accepted_publication": "Immediately after one exactly resolved direct lua_pushcclosure call, the same atlas range must contain contiguous x86 instructions with bytes for add esp,12; push imm32 key VA; push -2; push the same Lua-state register; and an exact direct FF 15 lua_setfield import call. The pointed key must be a bounded NUL-terminated ASCII string.",
    "callback_prerequisite_exactly_verified": true,
    "not_claimed": [
      "runtime reachability, execution, frequency, or persistence",
      "the dynamic identity, ownership, or lifetime of the target table",
      "global export, ordinary Lua lookup reachability, or later mutation",
      "publication through lua_settable, lua_rawset, or indirect API calls",
      "publication for unmatched or computed callback arguments",
      "function ownership, subsystem, purpose, inputs, or outputs",
      "source-level or behavioral equivalence"
    ],
    "partition": "Every resolved immediate callback site is retained exactly once as either an accepted setfield publication or an unmatched resolved site. Unmatched sites do not acquire a publication target.",
    "publication_boundary": "The artifact publishes normalized RVAs, atlas and instruction hashes, the bounded field key, prerequisite identities, and aggregates. It omits instruction bytes, disassembly text, decompiler output, local paths, variables, and reconstructed source.",
    "relation_semantics": "An accepted edge proves that the newly constructed C closure is the value immediately consumed by lua_setfield for one exact table index and key in this static instruction sequence."
  },
